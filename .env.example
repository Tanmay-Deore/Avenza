# =====================================================================
# AVENZA — ENVIRONMENT CONFIGURATION
# =====================================================================

# Custom Domain / Canonical Site Base URL
# In production, set this to your official domain (no trailing slash).
# Example: https://avenza.io or https://avenza.yourdomain.com
VITE_SITE_URL=https://your-domain.com

# Optional fallback for Next.js/CI environments if applicable:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
